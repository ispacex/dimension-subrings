Read("fam.g");
for par in [
  [2,4,6, 1,2, -1,4, -2,-4, 6, 14],
  [1,3,5, 1,2, -1,4, -2,-4, 3, 12],
  [2,3,5, 1,2, -1,4, -2,-4, 3, 12],
  [2,4,6, 1,1, 1,1, 1,1, 3, 12],
  [2,4,6, 1,2, -1,2, -2,-2, 3, 12],
  [3,5,7, 1,2, -1,4, -2,-4, 3, 14],
  [2,4,6, 2,1, -1,4, -2,-4, 4, 12],
  [1,2,3, 1,1, -1,1, -1,-1, 4, 12] ] do
  FAM(par, "fam2.jsonl");
od;
QUIT;
