# MATH-412 (bm_obs.g): sections M/N of the maximal subgroups M of bm_sec.g, for every normal N.
# (C2), (C3) in M/N read d c_d in N with c_d in gamma_k(M) for each failing d (bm_sec.g: N0 covers
# only c_d = 1).  Obstruction, for one failing d of level k: a word F(x) = [a,b,x]^(3^e) (or x in
# the first or middle place), a, b among x1..x4, with
#   (i)  F(d) in <w> \ 1, an identity in M, and
#   (ii) F(c) = 1 for every c in L = gamma_k(M), checked as: the subgroup S generated by the
#        commutators [a,b,c] (resp. [c,a,b], [a,c,b]), c in L, has exponent dividing 3^e.
# If d c in N, then in M/N d = c^-1, so F(d) = F(c^-1) = 1 there and w in N.  So one such F for one
# failing d shows that no section M/N satisfying (C2), (C3) keeps w.
Read("../3group.gap");
W := EvalString(w);;
XS := [x1, x2, x3, x4];;
YS2 := [x1, x2^9, x3^81, x4^729];;
YS3 := [LeftNormedComm([z2,z4,z1]), LeftNormedComm([z2,z4,z2]), LeftNormedComm([z2,z4,z3]), LeftNormedComm([z2,z4,z4])];;
LEV := [2, 2, 2, 2, 3, 3, 3, 3];;
NEED := [1, 2, 3, 4, 5, 6, 8];;
Check := function(H, y2, y3)
  local D, L3, bad;
  D := DerivedSubgroup(H);
  bad := Filtered([1..4], i -> not y2[i] in D);
  L3 := CommutatorSubgroup(D, H);
  Append(bad, Filtered([1..4], i -> not y3[i] in L3) + 4);
  return bad;
end;;
MaxOver := function(H, xs)
  local Fr, hom, V, S, res;
  Fr := FrattiniSubgroup(H);
  hom := NaturalHomomorphismByNormalSubgroupNC(H, Fr);
  V := Image(hom); S := Subgroup(V, List(xs, x -> Image(hom, x)));
  res := Filtered(MaximalSubgroups(V), K -> IsSubgroup(K, S));
  return List(res, K -> PreImage(hom, K));
end;;
# the word: place 1 = [x,a,b], 2 = [a,x,b], 3 = [a,b,x]
Word := function(place, x, a, b)
  if place = 1 then return LeftNormedComm([x, a, b]);
  elif place = 2 then return LeftNormedComm([a, x, b]);
  else return LeftNormedComm([a, b, x]); fi;
end;;
# e with v^(3^e) in <wQ> \ 1, or fail
PowerToW := function(v, wQ)
  local e, u;
  e := 0; u := v;
  while not IsOne(u) do
    if u in Group(wQ) then return e; fi;
    u := u^3; e := e + 1;
  od;
  return fail;
end;;
# the subgroup generated by the words with x running over L
WordSub := function(M, place, L, a, b)
  local A, B;
  A := Subgroup(M, [a]); B := Subgroup(M, [b]);
  if place = 1 then return CommutatorSubgroup(CommutatorSubgroup(L, A), B);
  elif place = 2 then return CommutatorSubgroup(CommutatorSubgroup(A, L), B);
  else return CommutatorSubgroup(Subgroup(M, [Comm(a, b)]), L); fi;
end;;
# one obstruction for M, or fail
Obstruct := function(M, bad, ys, xs, wQ)
  local L, Ls, p, place, i, j, e, S;
  Ls := LowerCentralSeriesOfGroup(M);
  for p in bad do
    L := Ls[LEV[p]];
    for place in [3, 2, 1] do
      for i in [1..4] do for j in [1..4] do
        if i = j then continue; fi;
        e := PowerToW(Word(place, ys[p], xs[i], xs[j]), wQ);
        if e = fail then continue; fi;
        S := WordSub(M, place, L, xs[i], xs[j]);
        if 3^e mod Exponent(S) = 0 then return [p, place, i, j, e, Log(Exponent(S), 3)]; fi;
      od; od;
    od;
  od;
  return fail;
end;;
ZG := Centre(G);; O := Omega(ZG, 3, 1);;
us := [];;
for u in AsList(O) do
  if not IsOne(u) and not u in Group(W) and ForAll(us, v -> not u in Group(v)) then Add(us, u); fi;
od;
cases := [];;
if IsBound(LEVEL0) and LEVEL0 then Add(cases, ["G", IdentityMapping(G)]); fi;
for k in [1..Length(us)] do Add(cases, [Concatenation("G/<u", String(k), ">"), NaturalHomomorphismByNormalSubgroupNC(G, Group(us[k]))]); od;
nall := 0;; nobs := 0;;
for c in cases do
  hom := c[2]; Q := Image(hom);
  xs := List(XS, x -> Image(hom, x));
  ys := List(Concatenation(YS2, YS3), y -> Image(hom, y)); wQ := Image(hom, W);
  t := Runtime();
  Ms := MaxOver(Q, xs);
  Print(c[1], ": log3|Q| = ", Log(Size(Q), 3), ", maximal subgroups containing x1..x4: ", Length(Ms), "\n");
  for M in Ms do
    nall := nall + 1;
    bad := Intersection(Check(M, ys{[1..4]}, ys{[5..8]}), NEED);
    ob := Obstruct(M, bad, ys, xs, wQ);
    if ob <> fail then nobs := nobs + 1; fi;
    Print("  M: fails ", bad, ", obstruction [pos, place, a, b, e, log3 exp S] = ", ob, "\n");
  od;
  Print("  sec ", Int((Runtime() - t) / 1000), "\n");
od;
Print("maximal subgroups: ", nall, ", with an obstruction: ", nobs, "\n");
QUIT;
