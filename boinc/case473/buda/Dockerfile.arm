# The BUDA variant arm_cpu's Dockerfile (image tag boinc473-v1, arm64) (boinc/case473/README.md, "BUDA"). BUDA builds it
# on the volunteer's host, so it only names the prebuilt image (by digest: the image is the version of the code) and
# runs main.sh, which BUDA copies with the input file into the job's directory, mounted at /app.
FROM ghcr.io/ispacex/dimension-subrings-case473-boinc@sha256:DIGEST_arm64
ENTRYPOINT []
WORKDIR /app
CMD /bin/sh ./main.sh
