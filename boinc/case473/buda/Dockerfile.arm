# The BUDA variant arm_cpu's Dockerfile (image tag boinc473-v2, arm64) (boinc/case473/README.md, "BUDA"). BUDA builds it
# on the volunteer's host, so it only names the prebuilt image (by digest: the image is the version of the code) and
# runs main.sh, which BUDA copies with the input file into the job's directory, mounted at /app.
FROM ghcr.io/ispacex/dimension-subrings-case473-boinc@sha256:297d328e38c352fdc1d0e86866ebc7562798761c47b464dab7cd7ab9f9237d1b
ENTRYPOINT []
WORKDIR /app
CMD /bin/sh ./main.sh
