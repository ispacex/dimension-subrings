[Unit]
Description=boinc-fetcher: collect finished BOINC Central batches, notify on problems
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=boinc-fetcher
Group=boinc-fetcher
ExecStart=/usr/bin/python3 -I /opt/boinc-fetcher/fetcher.py --config /etc/boinc-fetcher/config.json
StateDirectory=boinc-fetcher
StateDirectoryMode=0700
# results are readable by the other users on kimmy (the agent, tm jobs)
UMask=0022
Nice=10
IOSchedulingClass=idle
# a large batch tar can take a while; a killed run is noticed by the next one
TimeoutStartSec=12h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/boinc-results /var/lib/boinc-fetcher
ProtectHome=yes
