# The variant arm_cpu of BUDA app ds12 (the search at 2^12, image tag boinc-v6, arm64; boinc/README.md, "2^12").
# BUDA builds it on the volunteer's host, so it only names the prebuilt image (by digest: the image is the
# version of the code) and runs main_ds12.sh, which BUDA copies with the input file into the job's directory,
# mounted at /app.  In the file sandbox: Dockerfile_ds12_arm_v6, main_ds12.sh.
FROM ghcr.io/ispacex/dimension-subrings-boinc@sha256:0a2b93b75c4ffc3de3ed63b1bb185e458427e9c0ec806db8060dde7f460b79d2
ENTRYPOINT []
WORKDIR /app
ENV ARGS=""
CMD /bin/sh ./main_ds12.sh ${ARGS}
