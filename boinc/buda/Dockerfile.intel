# The BUDA variant intel_cpu's Dockerfile (image tag boinc-v1) (boinc/README.md, "BUDA"). BUDA builds it on the volunteer's host,
# so it only names the prebuilt image (by digest: the image is the version of the code) and runs
# main.sh, which BUDA copies with the input file into the job's directory, mounted at /app.
FROM ghcr.io/ispacex/dimension-subrings-boinc@sha256:68a7a3854b7cac4cf213eb610eaed5fd73d713790109cd3c3c18fa6284c22e4f
ENTRYPOINT []
WORKDIR /app
ENV ARGS=""
CMD /bin/sh ./main.sh ${ARGS}
